@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Up Activities";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar-check-fill text-warning me-2"></i> Follow-Up Management</h3>
        <p class="text-muted small mb-0">Track planned commitments, sales calls, meetings, and upcoming reminders</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-warning text-dark shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Scope Filter Badges -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" asp-route-scope="all" class="btn btn-sm @(Model.FilterScope == "all" || string.IsNullOrEmpty(Model.FilterScope) ? "btn-dark" : "btn-outline-dark")">
        All Tasks (@Model.TotalCount)
    </a>
    <a asp-action="Index" asp-route-scope="pending" class="btn btn-sm @(Model.FilterScope == "pending" ? "btn-primary" : "btn-outline-primary")">
        <i class="bi bi-hourglass-split me-1"></i> Pending (@Model.PendingCount)
    </a>
    <a asp-action="Index" asp-route-scope="upcoming" class="btn btn-sm @(Model.FilterScope == "upcoming" ? "btn-success" : "btn-outline-success")">
        <i class="bi bi-calendar-event me-1"></i> Upcoming (@Model.UpcomingCount)
    </a>
    <a asp-action="Index" asp-route-scope="overdue" class="btn btn-sm @(Model.FilterScope == "overdue" ? "btn-danger" : "btn-outline-danger")">
        <i class="bi bi-exclamation-triangle me-1"></i> Overdue (@Model.OverdueCount)
    </a>
</div>

<!-- Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="scope" value="@Model.FilterScope" />

            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search subject, customer, remarks..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in FollowUpStatuses.All)
                    {
                        <option value="@st" selected="@(Model.StatusFilter == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Type</label>
                <select name="typeFilter" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in FollowUpTypes.All)
                    {
                        <option value="@t" selected="@(Model.TypeFilter == t)">@t</option>
                    }
                </select>
            </div>
            @if (Model.AvailableUsers.Any())
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Assigned Rep</label>
                    <select name="assignedToFilter" class="form-select form-select-sm">
                        <option value="">All Reps</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Value" selected="@(Model.AssignedToFilter == user.Value)">@user.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.FollowUps.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Type</th>
                            <th>Subject & Remarks</th>
                            <th>Target Entity</th>
                            <th>Follow-Up Date & Time</th>
                            <th>Status</th>
                            <th>Assigned Rep</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FollowUps)
                        {
                            var isOverdue = f.Status == FollowUpStatuses.Planned && f.FollowUpDate < DateTime.Now;
                            <tr class="@(isOverdue ? "table-danger bg-opacity-25" : "")">
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi @(f.FollowUpType == "Call" ? "bi-telephone" : f.FollowUpType == "Meeting" ? "bi-people" : f.FollowUpType == "Email" ? "bi-envelope" : "bi-check2-square") me-1"></i>
                                        @f.FollowUpType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@f.Subject</div>
                                    @if (!string.IsNullOrEmpty(f.Remarks))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 320px;">@f.Remarks</div>
                                    }
                                </td>
                                <td class="small">
                                    @if (f.Customer != null)
                                    {
                                        <div><i class="bi bi-building text-muted me-1"></i> <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">@f.Customer.CustomerName</a></div>
                                    }
                                    @if (f.Lead != null)
                                    {
                                        <div><i class="bi bi-funnel text-muted me-1"></i> <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">@f.Lead.LeadName</a></div>
                                    }
                                    @if (f.Opportunity != null)
                                    {
                                        <div><i class="bi bi-cash text-muted me-1"></i> <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId" class="text-decoration-none">@f.Opportunity.OpportunityName</a></div>
                                    }
                                    @if (f.Customer == null && f.Lead == null && f.Opportunity == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small @(isOverdue ? "text-danger fw-bold" : "")">
                                    @f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statusBadge = f.Status switch
                                        {
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-secondary",
                                            "Missed" => "bg-danger",
                                            _ => "bg-primary"
                                        };
                                    }
                                    <span class="badge @statusBadge">@f.Status</span>
                                </td>
                                <td class="small">@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (f.Status == FollowUpStatuses.Planned)
                                        {
                                            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Mark Completed">
                                                <i class="bi bi-check-lg"></i> Complete
                                            </button>
                                        }
                                        <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-outline-primary" title="Reschedule / Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (f.Status == FollowUpStatuses.Planned)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-secondary" title="Cancel Follow-Up" onclick="return confirm('Cancel this follow-up?');">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>

                                    @if (f.Status == FollowUpStatuses.Planned)
                                    {
                                        <!-- Complete Follow-Up Modal -->
                                        <div class="modal fade" id="completeModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title text-success"><i class="bi bi-check-circle-fill me-1"></i> Complete Follow-Up</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-body">
                                                            <p class="mb-2">Mark <strong>@f.Subject</strong> as completed.</p>
                                                            <label class="form-label small fw-semibold">Outcome Notes / Remarks (Optional):</label>
                                                            <textarea name="remarks" class="form-control" rows="3" placeholder="Summary of call/meeting outcomes..."></textarea>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                                                            <button type="submit" class="btn btn-sm btn-success">Save & Mark Complete</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <nav aria-label="Follow-Up pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-scope="@Model.FilterScope" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-scope="@Model.FilterScope" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-searchTerm="@Model.SearchTerm">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-scope="@Model.FilterScope" asp-route-statusFilter="@Model.StatusFilter" asp-route-typeFilter="@Model.TypeFilter" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-calendar-check display-4 d-block mb-3 text-secondary"></i>
                <h5>No Follow-Ups Found</h5>
                <p class="small text-muted">No scheduled follow-up tasks match this view.</p>
                <a asp-action="Create" class="btn btn-sm btn-warning text-dark fw-semibold">Schedule Follow-Up</a>
            </div>
        }
    </div>
</div>
