@model AcxiomCRM.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<!-- Dashboard Header & Date Filter Toolbar -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center">
            <i class="bi bi-speedometer2 text-primary me-2"></i>
            CRM Dashboard
        </h2>
        <span class="text-muted small">
            Scope: <strong class="text-primary">@Model.ScopeDescription</strong> &bull; User: <strong>@Model.UserName</strong>
        </span>
    </div>

    <!-- Quick Date Filter Toolbar -->
    <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2 align-items-center">
        <div class="btn-group btn-group-sm" role="group" aria-label="Date Filters">
            <a asp-action="Index" asp-route-dateFilter="Today" class="btn @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
            <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
            <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
            <a asp-action="Index" asp-route-dateFilter="All" class="btn @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        </div>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Full Reports
        </a>
    </div>
</div>

<!-- Section 17.11 KPI Metric Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat shadow-sm border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                        <h3 class="fw-bold mb-0 mt-1">@Model.TotalCustomers</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Customers" asp-action="Index" class="text-primary small text-decoration-none fw-semibold">View Customers &rarr;</a>
                    <a asp-controller="Customers" asp-action="Create" class="btn btn-xs btn-outline-primary py-0 px-2">+ Add</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Leads & Open Leads -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat shadow-sm border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total / Open Leads</span>
                        <h3 class="fw-bold mb-0 mt-1">
                            @Model.TotalLeads
                            <span class="badge bg-info text-dark fs-6 ms-1" title="Open Active Leads">@Model.OpenLeads Open</span>
                        </h3>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-funnel-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Leads" asp-action="Index" class="text-info small text-decoration-none fw-semibold">Manage Leads &rarr;</a>
                    <a asp-controller="Leads" asp-action="Create" class="btn btn-xs btn-outline-info py-0 px-2">+ Capture</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Pipeline Value -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Open Pipeline Value</span>
                        <h3 class="fw-bold mb-0 mt-1 text-success">$@Model.TotalPipelineValue.ToString("N0")</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Weighted: <strong>$@Model.TotalWeightedPipelineValue.ToString("N0")</strong></span>
                    <a asp-controller="Opportunities" asp-action="Index" class="text-success small text-decoration-none fw-semibold">Pipeline &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Follow-Ups (Pending & Overdue) -->
    <div class="col-sm-6 col-xl-3">
        <div class="card card-stat shadow-sm border-start @(Model.OverdueFollowUps > 0 ? "border-danger" : "border-warning") border-4 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Pending Follow-Ups</span>
                        <h3 class="fw-bold mb-0 mt-1">
                            @Model.PendingFollowUps
                            @if (Model.OverdueFollowUps > 0)
                            {
                                <span class="badge bg-danger fs-6 ms-1" title="Overdue Actions">@Model.OverdueFollowUps Overdue</span>
                            }
                        </h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="bi bi-calendar-event-fill fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="FollowUps" asp-action="Index" asp-route-scope="pending" class="text-warning text-dark small text-decoration-none fw-semibold">View Calendar &rarr;</a>
                    <a asp-controller="FollowUps" asp-action="Create" class="btn btn-xs btn-outline-warning text-dark py-0 px-2">+ Plan</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Opportunity Breakdown Secondary KPIs -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted"><i class="bi bi-bullseye text-primary me-1"></i> Total Opportunities: <strong>@Model.TotalOpportunities</strong></span>
                <span class="badge bg-primary">@Model.OpenOpportunities Open</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted"><i class="bi bi-trophy-fill text-success me-1"></i> Won Opportunities: <strong>@Model.WonOpportunities</strong></span>
                <span class="badge bg-success">Closed Won</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                <span class="small text-muted"><i class="bi bi-x-circle text-secondary me-1"></i> Lost Opportunities: <strong>@Model.LostOpportunities</strong></span>
                <span class="badge bg-secondary">Closed Lost</span>
            </div>
        </div>
    </div>
</div>

<!-- Section 17.12 Chart.js Visualizations Row -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Opportunity Pipeline by Stage -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-bar-chart-steps text-primary me-2"></i>
                    Opportunity Pipeline by Stage
                </h5>
                <span class="text-muted small">Active deal amounts across pipeline progression</span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="pipelineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Lead Status Distribution -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0 d-flex align-items-center">
                    <i class="bi bi-pie-chart-fill text-info me-2"></i>
                    Lead Conversion & Status Distribution
                </h5>
                <span class="text-muted small">Status breakdown for prospective pipeline</span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 3: Monthly Sales Outcomes (Won vs Lost) -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i>
                        Monthly Sales Outcomes (Won vs Lost Revenue)
                    </h5>
                    <span class="text-muted small">Historical deal closure performance over recent months</span>
                </div>
                <span class="badge bg-light text-dark border">Section 17.12 Standard</span>
            </div>
            <div class="card-body">
                <div style="height: 280px; position: relative;">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Action CRM Tables Row -->
<div class="row g-4">
    <!-- Upcoming Follow-Ups Table -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-warning me-2"></i> Upcoming Scheduled Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingFollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Target</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fu in Model.UpcomingFollowUps)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary me-1">@fu.FollowUpType</span>
                                            <strong>@fu.Subject</strong>
                                        </td>
                                        <td class="small">@fu.FollowUpDate.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td class="small text-muted">
                                            @(fu.Customer?.CustomerName ?? fu.Lead?.LeadName ?? "—")
                                        </td>
                                        <td>
                                            <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@fu.FollowUpId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-xs btn-outline-success py-0 px-2" title="Mark Complete">
                                                    <i class="bi bi-check-lg"></i> Complete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-calendar-check display-6 d-block mb-2 text-muted"></i>
                        No pending follow-ups scheduled.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activities Table -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-activity text-primary me-2"></i> Recent CRM Touchpoints</h6>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentActivities.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Type</th>
                                    <th>Subject</th>
                                    <th>Contact</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var act in Model.RecentActivities)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge @(act.ActivityType == "Call" ? "bg-primary" : act.ActivityType == "Meeting" ? "bg-success" : act.ActivityType == "Email" ? "bg-info" : "bg-warning text-dark")">
                                                @act.ActivityType
                                            </span>
                                        </td>
                                        <td class="small fw-semibold">@act.Subject</td>
                                        <td class="small text-muted">@(act.Customer?.CustomerName ?? act.Lead?.LeadName ?? "—")</td>
                                        <td class="small text-muted">@act.ActivityDate.ToString("MMM dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-journal-text display-6 d-block mb-2 text-muted"></i>
                        No recent activities recorded.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Pipeline Chart (Bar)
            var pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
            new Chart(pipelineCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                    datasets: [{
                        label: 'Total Value ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts)),
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.75)',
                            'rgba(147, 51, 234, 0.75)',
                            'rgba(245, 158, 11, 0.75)',
                            'rgba(16, 185, 129, 0.75)',
                            'rgba(107, 114, 128, 0.75)'
                        ],
                        borderColor: [
                            'rgb(59, 130, 246)',
                            'rgb(147, 51, 234)',
                            'rgb(245, 158, 11)',
                            'rgb(16, 185, 129)',
                            'rgb(107, 114, 128)'
                        ],
                        borderWidth: 1.5,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '$' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });

            // 2. Lead Status Chart (Doughnut)
            var leadCtx = document.getElementById('leadStatusChart').getContext('2d');
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                        backgroundColor: [
                            '#3b82f6', // New
                            '#06b6d4', // Contacted
                            '#10b981', // Qualified
                            '#ef4444', // Lost
                            '#8b5cf6'  // Converted
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // 3. Monthly Sales Outcomes (Grouped Bar / Line)
            var salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                    datasets: [
                        {
                            label: 'Won Amount ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyWonAmounts)),
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderColor: 'rgb(16, 185, 129)',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Lost Amount ($)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLostAmounts)),
                            backgroundColor: 'rgba(239, 68, 68, 0.7)',
                            borderColor: 'rgb(239, 68, 68)',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': $' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '$' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
