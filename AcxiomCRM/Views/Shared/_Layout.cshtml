@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@using AcxiomCRM.Models.Enums
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --crm-primary: #0d6efd;
            --crm-dark: #1e293b;
            --crm-sidebar: #0f172a;
        }
        body {
            background-color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand-logo {
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .main-content {
            flex: 1 0 auto;
        }
        .footer {
            flex-shrink: 0;
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
        }
        .card-stat {
            transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            border: none;
            border-radius: 0.75rem;
        }
        .card-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
        }
        .badge-role-admin { background-color: #dc2626; color: #fff; }
        .badge-role-manager { background-color: #d97706; color: #fff; }
        .badge-role-sales { background-color: #2563eb; color: #fff; }
        .field-validation-error { color: #dc3545; font-size: 0.875rem; margin-top: 0.25rem; display: block; }
        .input-validation-error { border-color: #dc3545; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand navbar-brand-logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill text-primary me-2 fs-4"></i>
                    <span>Acxiom<span class="text-primary">CRM</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
                        var primaryRole = userRoles.FirstOrDefault() ?? RoleConstants.SalesExecutive;

                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people-fill me-1"></i> Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-funnel-fill me-1"></i> Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Opportunities" ? "active" : "")" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-cash-stack me-1"></i> Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-check-fill me-1"></i> Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Activities" ? "active" : "")" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-clock-history me-1"></i> Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line-fill me-1"></i> Reports
                                </a>
                            </li>

                            @if (User.IsInRole(RoleConstants.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Administration
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2"></i> User & Role Management</a></li>
                                        <li><a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text me-2"></i> Audit Logs</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="/api/customers" target="_blank"><i class="bi bi-braces me-2"></i> REST API (Customers)</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-2"></i>
                                    <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                    <span class="badge ms-2 @(primaryRole == RoleConstants.Admin ? "badge-role-admin" : primaryRole == RoleConstants.Manager ? "badge-role-manager" : "badge-role-sales")">
                                        @primaryRole
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuBtn">
                                    <li class="dropdown-header">Logged in as @currentUser?.Email</li>
                                    <li><span class="dropdown-item-text text-muted small">Role: <strong>@primaryRole</strong></span></li>
                                    @if (!string.IsNullOrEmpty(currentUser?.Department))
                                    {
                                        <li><span class="dropdown-item-text text-muted small">Dept: @currentUser.Department</span></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 text-start">
                                                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary ms-lg-2" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Register
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content py-4">
        <div class="container-fluid px-lg-4">
            @* Flash Notifications *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                    @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="footer py-3 text-muted">
        <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center">
            <span class="small">&copy; @DateTime.UtcNow.Year AcxiomCRM — Enterprise Customer Relationship Management System</span>
            <span class="small">ASP.NET Core 8.0 &bull; EF Core &bull; Bootstrap 5 &bull; Chart.js</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
