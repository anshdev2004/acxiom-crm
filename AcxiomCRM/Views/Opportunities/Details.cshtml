@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Opportunity.OpportunityName} - Opportunity";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Opportunities</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Opportunity.OpportunityName</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0">
            @Model.Opportunity.OpportunityName
            <span class="badge @(Model.Opportunity.Stage == "Won" ? "bg-success" : Model.Opportunity.Stage == "Lost" ? "bg-danger" : "bg-primary") fs-6 ms-2">
                @Model.Opportunity.Stage
            </span>
        </h3>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-warning text-dark btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
        </a>
        @if (Model.Opportunity.CustomerId > 0)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-building me-1"></i> Customer Profile
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Deal Financial & Pipeline Information -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-cash-stack text-success me-2"></i> Deal Metrics & Progression</h6>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Target Customer:</span>
                        <span class="fw-bold">
                            @if (Model.Opportunity.Customer != null)
                            {
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId" class="text-decoration-none">
                                    @Model.Opportunity.Customer.CustomerName (@Model.Opportunity.Customer.CustomerCode)
                                </a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Deal Value:</span>
                        <span class="fw-bold fs-5 text-success">$@Model.Opportunity.Amount.ToString("N2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Probability:</span>
                        <span class="fw-bold">@Model.Opportunity.Probability%</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Weighted Pipeline Value:</span>
                        <span class="fw-bold text-primary">$@Model.Opportunity.WeightedAmount.ToString("N2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Pipeline Stage:</span>
                        <span class="badge bg-secondary">@Model.Opportunity.Stage</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Deal Status:</span>
                        <span class="badge @(Model.Opportunity.Status == "Won" ? "bg-success" : Model.Opportunity.Status == "Lost" ? "bg-danger" : "bg-primary")">
                            @Model.Opportunity.Status
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Expected Close Date:</span>
                        <span class="fw-semibold">@Model.Opportunity.ExpectedCloseDate.ToString("yyyy-MM-dd")</span>
                    </li>
                    @if (Model.Opportunity.OutcomeDate.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between px-0 bg-light p-2 rounded">
                            <span class="text-muted fw-bold">Actual Outcome Date:</span>
                            <span class="fw-bold">@Model.Opportunity.OutcomeDate.Value.ToString("yyyy-MM-dd")</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Deal Owner:</span>
                        <span>@(Model.Opportunity.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created:</span>
                        <span>@Model.Opportunity.CreatedDate.ToString("yyyy-MM-dd HH:mm")</span>
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(Model.Opportunity.Notes))
                {
                    <div class="mt-3">
                        <span class="fw-semibold small d-block mb-1">Deal Notes:</span>
                        <p class="small text-muted bg-light p-2 rounded mb-0">@Model.Opportunity.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups for Deal -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-event text-warning me-2"></i> Deal Action Items & Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-xs btn-outline-warning text-dark">
                    + Add Task
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Subject</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="fw-semibold small">@f.Subject</td>
                                        <td class="small">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                        <td><span class="badge bg-secondary">@f.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">
                        No follow-up actions logged for this deal.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
