@model AcxiomCRM.ViewModels.OpportunityListViewModel
@{
    ViewData["Title"] = "Sales Opportunities";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-cash-stack text-success me-2"></i> Sales Pipeline Opportunities</h3>
        <p class="text-muted small mb-0">Total: @Model.TotalCount opportunity records in scope</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Financial Pipeline Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-primary text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-uppercase opacity-75 fw-semibold">Total Open Pipeline</span>
                    <h2 class="fw-bold mb-0 mt-1">$@Model.TotalPipelineValue.ToString("N2")</h2>
                </div>
                <div class="fs-1 opacity-50"><i class="bi bi-wallet2"></i></div>
            </div>
            <span class="small opacity-75 mt-2">Sum of all active non-closed deal amounts</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-dark text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="small text-uppercase opacity-75 fw-semibold text-warning">Weighted Pipeline Forecast</span>
                    <h2 class="fw-bold mb-0 mt-1 text-warning">$@Model.TotalWeightedPipelineValue.ToString("N2")</h2>
                </div>
                <div class="fs-1 opacity-50 text-warning"><i class="bi bi-pie-chart"></i></div>
            </div>
            <span class="small opacity-75 mt-2">Calculated as: &sum; (Amount &times; Probability / 100)</span>
        </div>
    </div>
</div>

<!-- Search & Filtering Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search opportunity, customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Stage</label>
                <select name="stageFilter" class="form-select form-select-sm">
                    <option value="">All Stages</option>
                    @foreach (var stg in OpportunityStages.AllStages)
                    {
                        <option value="@stg" selected="@(Model.StageFilter == stg)">@stg</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Open" selected="@(Model.StatusFilter == "Open")">Open Deals</option>
                    <option value="Won" selected="@(Model.StatusFilter == "Won")">Closed Won</option>
                    <option value="Lost" selected="@(Model.StatusFilter == "Lost")">Closed Lost</option>
                </select>
            </div>
            @if (Model.AvailableUsers.Any())
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Owner</label>
                    <select name="ownerFilter" class="form-select form-select-sm">
                        <option value="">All Reps</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Value" selected="@(Model.OwnerFilter == user.Value)">@user.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Opportunities Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Opportunities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Opportunity Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Amount</th>
                            <th>Weighted Value</th>
                            <th>Close Date</th>
                            <th>Owner</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Opportunities)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-bold text-decoration-none">
                                        @o.OpportunityName
                                    </a>
                                </td>
                                <td>
                                    @if (o.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId" class="small text-decoration-none">
                                            @o.Customer.CustomerName
                                        </a>
                                    }
                                </td>
                                <td>
                                    @{
                                        var badgeColor = o.Stage switch
                                        {
                                            "Won" => "bg-success",
                                            "Lost" => "bg-danger",
                                            "Negotiation" => "bg-warning text-dark",
                                            "Proposal" => "bg-info text-dark",
                                            _ => "bg-primary"
                                        };
                                    }
                                    <span class="badge @badgeColor">@o.Stage</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="small fw-semibold me-2">@o.Probability%</span>
                                        <div class="progress flex-grow-1" style="height: 6px; width: 50px;">
                                            <div class="progress-bar @(o.Probability >= 80 ? "bg-success" : o.Probability >= 50 ? "bg-info" : "bg-warning")" style="width: @o.Probability%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-bold text-dark">$@o.Amount.ToString("N2")</td>
                                <td class="fw-semibold text-muted small">$@o.WeightedAmount.ToString("N2")</td>
                                <td class="small @(o.ExpectedCloseDate.Date < DateTime.Today && o.Status == "Open" ? "text-danger fw-bold" : "text-muted")">
                                    @o.ExpectedCloseDate.ToString("yyyy-MM-dd")
                                    @if (o.ExpectedCloseDate.Date < DateTime.Today && o.Status == "Open")
                                    {
                                        <i class="bi bi-exclamation-circle text-danger ms-1" title="Past due"></i>
                                    }
                                </td>
                                <td class="small">@(o.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-outline-primary" title="Edit Opportunity">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@o.OpportunityId" title="Delete Opportunity">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Modal -->
                                    <div class="modal fade" id="deleteModal-@o.OpportunityId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Confirm Delete</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Are you sure you want to delete opportunity <strong>@o.OpportunityName</strong> ($@o.Amount.ToString("N2"))?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@o.OpportunityId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <nav aria-label="Opportunity pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-ownerFilter="@Model.OwnerFilter">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-ownerFilter="@Model.OwnerFilter">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-stageFilter="@Model.StageFilter" asp-route-statusFilter="@Model.StatusFilter" asp-route-ownerFilter="@Model.OwnerFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-cash-stack display-4 d-block mb-3 text-secondary"></i>
                <h5>No Opportunities Found</h5>
                <p class="small text-muted">No deals match your criteria or user permissions.</p>
                <a asp-action="Create" class="btn btn-sm btn-success">Create Opportunity</a>
            </div>
        }
    </div>
</div>
