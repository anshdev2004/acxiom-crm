@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <div class="card-body">
                <i class="bi bi-x-octagon-fill text-danger display-2 mb-3"></i>
                <h3 class="fw-bold text-danger">403 — Access Denied</h3>
                <p class="text-muted mt-3">
                    You do not have the required role privileges or record ownership permissions to access this CRM resource.
                </p>
                <div class="alert alert-secondary py-2 small text-start my-3">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Role Scoping Policy:</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        <li><strong>Sales Executive:</strong> Access only assigned records.</li>
                        <li><strong>Manager:</strong> Team records and management pipeline.</li>
                        <li><strong>Admin:</strong> System administration, audit logs, and security controls.</li>
                    </ul>
                </div>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-speedometer2 me-1"></i> Go to My Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
