@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <div class="card-body">
                <i class="bi bi-shield-slash-fill text-danger display-2 mb-3"></i>
                <h3 class="fw-bold text-danger">Account Temporarily Locked</h3>
                <p class="text-muted mt-3">
                    Your account has been temporarily locked out after <strong>5 consecutive failed login attempts</strong> to protect against unauthorized brute-force access.
                </p>
                <div class="alert alert-warning py-2 small text-start my-3">
                    <i class="bi bi-clock-history me-1"></i>
                    <strong>Lockout Duration:</strong> The standard lockout window is 15 minutes. Alternatively, a system administrator can unlock your account immediately from the User Management console.
                </div>
                <div class="d-flex justify-content-center gap-2 mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-1"></i> Return to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
