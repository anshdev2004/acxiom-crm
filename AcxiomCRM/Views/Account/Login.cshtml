@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-diagram-3-fill text-primary display-4"></i>
                    <h3 class="fw-bold mt-2">Acxiom<span class="text-primary">CRM</span></h3>
                    <p class="text-muted small">Sign in to your CRM workspace</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" id="loginEmail" placeholder="name@example.com" autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" id="loginPassword" type="password" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>
                </form>

                <div class="text-center text-muted small mt-3">
                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                </div>

                <hr class="my-4" />

                <!-- Demonstration Quick Credentials for Evaluators -->
                <div class="bg-light p-3 rounded-2 border">
                    <span class="fw-bold small d-block mb-2 text-dark"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Logins:</span>
                    <div class="d-flex flex-column gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin@acxiomcrm.local', 'Admin@12345!')">
                            <span><strong>Admin:</strong> admin@acxiomcrm.local</span>
                            <span class="badge bg-danger">Fill</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning text-start text-dark d-flex justify-content-between align-items-center" onclick="fillCredentials('manager@acxiomcrm.local', 'Manager@12345!')">
                            <span><strong>Manager:</strong> manager@acxiomcrm.local</span>
                            <span class="badge bg-warning text-dark">Fill</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('sales1@acxiomcrm.local', 'Sales@12345!')">
                            <span><strong>Sales Executive:</strong> sales1@acxiomcrm.local</span>
                            <span class="badge bg-primary">Fill</span>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, pwd) {
            document.getElementById('loginEmail').value = email;
            document.getElementById('loginPassword').value = pwd;
        }
    </script>
}
