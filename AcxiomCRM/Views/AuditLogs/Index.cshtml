@model List<AcxiomCRM.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Logs";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-shield-check text-danger me-2"></i> System Audit & Compliance Trail</h3>
        <p class="text-muted small mb-0">Append-only immutable record of authentication, data mutations, role changes, and security events</p>
    </div>
    <span class="badge bg-danger fs-6">Admin Audit Console</span>
</div>

<!-- Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search Details / Email</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search user email or detail..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Action</label>
                <select name="actionFilter" class="form-select form-select-sm">
                    <option value="">All Actions</option>
                    <option value="Login" selected="@(ViewBag.ActionFilter == "Login")">Login</option>
                    <option value="Failed Login" selected="@(ViewBag.ActionFilter == "Failed Login")">Failed Login</option>
                    <option value="Logout" selected="@(ViewBag.ActionFilter == "Logout")">Logout</option>
                    <option value="Create" selected="@(ViewBag.ActionFilter == "Create")">Create</option>
                    <option value="Update" selected="@(ViewBag.ActionFilter == "Update")">Update</option>
                    <option value="Delete" selected="@(ViewBag.ActionFilter == "Delete")">Delete</option>
                    <option value="Lead Conversion" selected="@(ViewBag.ActionFilter == "Lead Conversion")">Lead Conversion</option>
                    <option value="Role Change" selected="@(ViewBag.ActionFilter == "Role Change")">Role Change</option>
                    <option value="Security" selected="@(ViewBag.ActionFilter == "Security")">Security</option>
                    <option value="Account Lockout" selected="@(ViewBag.ActionFilter == "Account Lockout")">Account Lockout</option>
                    <option value="Account Unlock" selected="@(ViewBag.ActionFilter == "Account Unlock")">Account Unlock</option>
                    <option value="Password Reset" selected="@(ViewBag.ActionFilter == "Password Reset")">Password Reset</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Entity Module</label>
                <select name="entityFilter" class="form-select form-select-sm">
                    <option value="">All Entities</option>
                    <option value="Customer" selected="@(ViewBag.EntityFilter == "Customer")">Customer</option>
                    <option value="Lead" selected="@(ViewBag.EntityFilter == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(ViewBag.EntityFilter == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(ViewBag.EntityFilter == "FollowUp")">FollowUp</option>
                    <option value="Activity" selected="@(ViewBag.EntityFilter == "Activity")">Activity</option>
                    <option value="ApplicationUser" selected="@(ViewBag.EntityFilter == "ApplicationUser")">User Account</option>
                    <option value="Authentication" selected="@(ViewBag.EntityFilter == "Authentication")">Authentication</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Logs Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 font-monospace small">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Timestamp (UTC)</th>
                            <th>Actor / Email</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record ID</th>
                            <th>Result</th>
                            <th>IP Address</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.AuditLogId</td>
                                <td class="text-nowrap">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(a.UserEmail ?? "Anonymous")</td>
                                <td>
                                    @{
                                        var actionBadge = a.Action switch
                                        {
                                            "Login" => "bg-success",
                                            "Failed Login" => "bg-danger",
                                            "Account Lockout" => "bg-danger",
                                            "Account Unlock" => "bg-warning text-dark",
                                            "Role Change" => "bg-warning text-dark",
                                            "Delete" => "bg-danger",
                                            "Lead Conversion" => "bg-purple text-white",
                                            _ => "bg-primary"
                                        };
                                    }
                                    <span class="badge @actionBadge" style="@(a.Action == "Lead Conversion" ? "background-color: #8b5cf6;" : "")">
                                        @a.Action
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                                <td>@(a.RecordId ?? "—")</td>
                                <td>
                                    <span class="badge @(a.Result == "Success" ? "bg-success" : a.Result == "Locked" ? "bg-danger" : "bg-warning text-dark")">
                                        @a.Result
                                    </span>
                                </td>
                                <td>@(a.IpAddress ?? "127.0.0.1")</td>
                                <td class="text-truncate" style="max-width: 320px;" title="@a.Details">
                                    @a.Details
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted font-sans-serif">Page @ViewBag.CurrentPage of @ViewBag.TotalPages (Total: @ViewBag.TotalCount records)</span>
                    <nav aria-label="Audit pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-actionFilter="@ViewBag.ActionFilter" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">Previous</a>
                            </li>
                            @for (int p = 1; p <= ViewBag.TotalPages; p++)
                            {
                                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-actionFilter="@ViewBag.ActionFilter" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">@p</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-actionFilter="@ViewBag.ActionFilter" asp-route-entityFilter="@ViewBag.EntityFilter" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-journal-text display-4 d-block mb-3 text-secondary"></i>
                <h5>No Audit Records Found</h5>
                <p class="small text-muted">No security or business events matched your query.</p>
            </div>
        }
    </div>
</div>
