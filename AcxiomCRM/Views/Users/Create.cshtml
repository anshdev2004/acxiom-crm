@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Create User Account";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">User Management</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create User</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold mb-0 text-danger"><i class="bi bi-person-plus-fill me-2"></i> Create CRM User Account</h4>
                <span class="text-muted small">Admin privilege: assign role, team hierarchy, and initial password</span>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" autofocus />
                            <span asp-validation-for="FullName"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold small">Department</label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold small">Primary Role <span class="text-danger">*</span></label>
                            <select asp-for="Role" asp-items="Model.AvailableRoles" class="form-select">
                            </select>
                            <span asp-validation-for="Role"></span>
                            <div class="form-text small">Each user is assigned exactly one primary role.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ManagerId" class="form-label fw-semibold small">Team Manager (Hierarchy)</label>
                            <select asp-for="ManagerId" asp-items="Model.AvailableManagers" class="form-select">
                                <option value="">-- No Direct Manager --</option>
                            </select>
                            <span asp-validation-for="ManagerId"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small">Initial Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label small fw-semibold">Account Active (Enabled for login)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Create Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
