@model AcxiomCRM.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User & Role Administration";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-gear text-danger me-2"></i> User & Access Administration</h3>
        <p class="text-muted small mb-0">Authorized Admin Console: manage accounts, role assignments, lockouts, and security credentials</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-danger shadow-sm fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Create User Account
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Search Users</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, email, department..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Role</label>
                <select name="roleFilter" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    @foreach (var r in RoleConstants.AllRoles)
                    {
                        <option value="@r" selected="@(Model.RoleFilter == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Account State</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All States</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Deactivated</option>
                    <option value="Locked" selected="@(Model.StatusFilter == "Locked")">Locked Out</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>User Name</th>
                        <th>Email & Contact</th>
                        <th>Primary Role</th>
                        <th>Department</th>
                        <th>Team Manager</th>
                        <th>Account Status</th>
                        <th>Lockout Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@u.FullName</div>
                                <span class="text-muted small">ID: @u.Id.Substring(0, Math.Min(8, u.Id.Length))...</span>
                            </td>
                            <td>
                                <div><a href="mailto:@u.Email" class="text-decoration-none small">@u.Email</a></div>
                                <div class="small text-muted">@(u.PhoneNumber ?? "—")</div>
                            </td>
                            <td>
                                <span class="badge @(u.Role == RoleConstants.Admin ? "bg-danger" : u.Role == RoleConstants.Manager ? "bg-warning text-dark" : "bg-primary")">
                                    @u.Role
                                </span>
                            </td>
                            <td class="small">@(u.Department ?? "—")</td>
                            <td class="small text-muted">@(u.ManagerName ?? "—")</td>
                            <td>
                                <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")">
                                    @(u.IsActive ? "Active" : "Deactivated")
                                </span>
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked Out</span>
                                    <div class="small text-danger">Until: @u.LockoutEnd?.ToString("HH:mm")</div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border">Normal</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-outline-warning text-dark" title="Admin Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>

                                    @if (u.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Unlock User Account">
                                                <i class="bi bi-unlock"></i> Unlock
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Toggle active/inactive status for @u.Email?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate User" : "Activate User")">
                                            <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
