@model AcxiomCRM.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset Password - {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">User Management</a></li>
                <li class="breadcrumb-item active" aria-current="page">Reset Password</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold mb-0 text-warning text-dark"><i class="bi bi-key-fill text-warning me-2"></i> Administrative Password Reset</h4>
                <span class="text-muted small">Set new secure password for: <strong>@Model.FullName</strong> (@Model.UserEmail)</span>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="ResetPassword" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserEmail" />
                    <input type="hidden" asp-for="FullName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small">New Password <span class="text-danger">*</span></label>
                        <input asp-for="NewPassword" class="form-control" type="password" autofocus />
                        <span asp-validation-for="NewPassword"></span>
                        <div class="form-text small">Minimum 8 characters with lowercase, uppercase, digit, and special character.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm New Password <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
