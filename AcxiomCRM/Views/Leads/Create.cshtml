@model AcxiomCRM.ViewModels.LeadEditViewModel
@{
    ViewData["Title"] = "Capture New Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                <li class="breadcrumb-item active" aria-current="page">New Lead</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold mb-0 text-info"><i class="bi bi-funnel-fill me-2"></i> Capture Prospect Lead</h4>
                <span class="text-muted small">Record prospective sales lead details with stage qualification</span>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small">Lead Contact Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" placeholder="Jane Doe" autofocus />
                            <span asp-validation-for="LeadName"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" placeholder="FinTech Partners LLC" />
                            <span asp-validation-for="CompanyName"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="jane@fintech.com" />
                            <span asp-validation-for="Email"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" placeholder="+1-555-8888" />
                            <span asp-validation-for="Phone"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label fw-semibold small">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                @foreach (var src in LeadSources.All)
                                {
                                    <option value="@src">@src</option>
                                }
                            </select>
                            <span asp-validation-for="Source"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">Initial Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Qualified">Qualified</option>
                            </select>
                            <span asp-validation-for="Status"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold small">Priority <span class="text-danger">*</span></label>
                            <select asp-for="Priority" class="form-select">
                                @foreach (var pr in LeadPriorities.All)
                                {
                                    <option value="@pr">@pr</option>
                                }
                            </select>
                            <span asp-validation-for="Priority"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small">Expected Value ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="ExpectedValue"></span>
                        </div>

                        @if (Model.AvailableUsers.Any())
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small">Assign Sales Executive</label>
                                <select asp-for="AssignedTo" asp-items="Model.AvailableUsers" class="form-select">
                                    <option value="">-- Assign to Me --</option>
                                </select>
                                <span asp-validation-for="AssignedTo"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold small">Notes & Requirements</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Customer pain points, budget, timeline notes..."></textarea>
                            <span asp-validation-for="Notes"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-info text-dark px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
