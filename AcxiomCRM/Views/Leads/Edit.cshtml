@model AcxiomCRM.ViewModels.LeadEditViewModel
@{
    ViewData["Title"] = $"Edit Lead - {Model.LeadName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadCode</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-info"><i class="bi bi-pencil-square me-2"></i> Edit Lead Profile</h4>
                    <span class="text-muted small">Update prospect information for <strong>@Model.LeadCode</strong></span>
                </div>
                <span class="badge bg-light text-dark border">@Model.LeadCode</span>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="Edit" asp-route-id="@Model.LeadId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label fw-semibold small">Lead Name <span class="text-danger">*</span></label>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold small">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Source" class="form-label fw-semibold small">Lead Source <span class="text-danger">*</span></label>
                            <select asp-for="Source" class="form-select">
                                @foreach (var src in LeadSources.All)
                                {
                                    <option value="@src" selected="@(Model.Source == src)">@src</option>
                                }
                            </select>
                            <span asp-validation-for="Source"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold small">Lead Status <span class="text-danger">*</span></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var st in LeadStatuses.AllStatuses)
                                {
                                    <option value="@st" selected="@(Model.Status == st)">@st</option>
                                }
                            </select>
                            <span asp-validation-for="Status"></span>
                            <div class="form-text small">Invalid status transitions are prevented.</div>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold small">Priority <span class="text-danger">*</span></label>
                            <select asp-for="Priority" class="form-select">
                                @foreach (var pr in LeadPriorities.All)
                                {
                                    <option value="@pr" selected="@(Model.Priority == pr)">@pr</option>
                                }
                            </select>
                            <span asp-validation-for="Priority"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedValue" class="form-label fw-semibold small">Expected Value ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="ExpectedValue"></span>
                        </div>

                        @if (Model.AvailableUsers.Any())
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small">Assigned Rep</label>
                                <select asp-for="AssignedTo" asp-items="Model.AvailableUsers" class="form-select">
                                    <option value="">-- Keep Current --</option>
                                </select>
                                <span asp-validation-for="AssignedTo"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold small">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-info text-dark px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Update Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
