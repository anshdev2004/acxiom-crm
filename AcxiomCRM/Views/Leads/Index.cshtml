@model AcxiomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-funnel-fill text-info me-2"></i> Leads</h3>
        <p class="text-muted small mb-0">Total: @Model.TotalCount prospect leads captured</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-info text-dark shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Capture New Lead
        </a>
    </div>
</div>

<!-- Search & Filtering Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name, company, email..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var st in LeadStatuses.AllStatuses)
                    {
                        <option value="@st" selected="@(Model.StatusFilter == st)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Priority</label>
                <select name="priorityFilter" class="form-select form-select-sm">
                    <option value="">All Priorities</option>
                    @foreach (var pr in LeadPriorities.All)
                    {
                        <option value="@pr" selected="@(Model.PriorityFilter == pr)">@pr</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Source</label>
                <select name="sourceFilter" class="form-select form-select-sm">
                    <option value="">All Sources</option>
                    @foreach (var src in LeadSources.All)
                    {
                        <option value="@src" selected="@(Model.SourceFilter == src)">@src</option>
                    }
                </select>
            </div>
            @if (Model.AvailableUsers.Any())
            {
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Assigned Rep</label>
                    <select name="assignedToFilter" class="form-select form-select-sm">
                        <option value="">All Reps</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Value" selected="@(Model.AssignedToFilter == user.Value)">@user.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Leads Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Leads.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Code</th>
                            <th>Lead Contact</th>
                            <th>Company</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Est. Value</th>
                            <th>Assigned To</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Leads)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border fw-monospace">@l.LeadCode</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-bold text-decoration-none">
                                        @l.LeadName
                                    </a>
                                    <div class="small text-muted">@l.Email &bull; @l.Phone</div>
                                </td>
                                <td>@(l.CompanyName ?? "—")</td>
                                <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                                <td>
                                    @{
                                        var badgeClass = l.Status switch
                                        {
                                            "New" => "bg-primary",
                                            "Contacted" => "bg-info text-dark",
                                            "Qualified" => "bg-success",
                                            "Converted" => "bg-purple text-white",
                                            "Lost" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass" style="@(l.Status == "Converted" ? "background-color: #8b5cf6;" : "")">
                                        @l.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(l.Priority == "Critical" ? "bg-danger" : l.Priority == "High" ? "bg-warning text-dark" : "bg-light text-dark border")">
                                        @l.Priority
                                    </span>
                                </td>
                                <td class="fw-semibold text-success">$@l.ExpectedValue.ToString("N0")</td>
                                <td class="small">@(l.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (l.Status != LeadStatuses.Converted)
                                        {
                                            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-outline-success" title="Convert to Customer/Opportunity">
                                                <i class="bi bi-arrow-repeat"></i> Convert
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId" class="btn btn-sm btn-outline-dark" title="View Customer">
                                                <i class="bi bi-box-arrow-up-right"></i> Customer
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-outline-primary" title="Edit Lead">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (l.Status != LeadStatuses.Converted)
                                        {
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@l.LeadId" title="Delete Lead">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (l.Status != LeadStatuses.Converted)
                                    {
                                        <!-- Delete Modal -->
                                        <div class="modal fade" id="deleteModal-@l.LeadId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content text-start">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Confirm Delete</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete lead <strong>@l.LeadName</strong> (@l.LeadCode)?
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <nav aria-label="Lead pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-sourceFilter="@Model.SourceFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-sourceFilter="@Model.SourceFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter" asp-route-priorityFilter="@Model.PriorityFilter" asp-route-sourceFilter="@Model.SourceFilter" asp-route-assignedToFilter="@Model.AssignedToFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-funnel display-4 d-block mb-3 text-secondary"></i>
                <h5>No Leads Found</h5>
                <p class="small text-muted">No lead records matched your search criteria or role scope.</p>
                <a asp-action="Create" class="btn btn-sm btn-info text-dark fw-semibold">Capture Lead</a>
            </div>
        }
    </div>
</div>
