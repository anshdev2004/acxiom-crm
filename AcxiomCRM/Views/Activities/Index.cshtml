@model AcxiomCRM.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "Activity Log";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i> Activity Management</h3>
        <p class="text-muted small mb-0">Record of calls, meetings, emails, and tasks conducted across CRM accounts</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Log Activity
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search subject, description, customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    @foreach (var t in ActivityTypes.All)
                    {
                        <option value="@t" selected="@(Model.TypeFilter == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            @if (Model.AvailableUsers.Any())
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Assigned Rep</label>
                    <select name="assignedTo" class="form-select form-select-sm">
                        <option value="">All Reps</option>
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <option value="@user.Value" selected="@(Model.AssignedToFilter == user.Value)">@user.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filter">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Activities Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Activities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Type</th>
                            <th>Subject & Description</th>
                            <th>Target Contact</th>
                            <th>Activity Date</th>
                            <th>Status</th>
                            <th>Rep</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Activities)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(a.ActivityType == "Call" ? "bg-primary" : a.ActivityType == "Meeting" ? "bg-success" : a.ActivityType == "Email" ? "bg-info text-dark" : "bg-warning text-dark")">
                                        @a.ActivityType
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold">@a.Subject</div>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 320px;">@a.Description</div>
                                    }
                                </td>
                                <td class="small">
                                    @if (a.Customer != null)
                                    {
                                        <div><i class="bi bi-building text-muted me-1"></i> <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId" class="text-decoration-none">@a.Customer.CustomerName</a></div>
                                    }
                                    @if (a.Lead != null)
                                    {
                                        <div><i class="bi bi-funnel text-muted me-1"></i> <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId" class="text-decoration-none">@a.Lead.LeadName</a></div>
                                    }
                                    @if (a.Customer == null && a.Lead == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small text-muted">@a.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge bg-secondary">@a.Status</span></td>
                                <td class="small">@(a.AssignedUser?.FullName ?? "Unassigned")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@a.ActivityId" class="btn btn-outline-primary" title="Edit Activity">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@a.ActivityId" method="post" class="d-inline" onsubmit="return confirm('Delete this activity entry?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Activity">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
                    <nav aria-label="Activity pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-type="@Model.TypeFilter" asp-route-status="@Model.StatusFilter" asp-route-assignedTo="@Model.AssignedToFilter" asp-route-search="@Model.SearchTerm">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-clock-history display-4 d-block mb-3 text-secondary"></i>
                <h5>No Activities Logged</h5>
                <p class="small text-muted">No calls, meetings, or emails have been logged yet.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Log Activity</a>
            </div>
        }
    </div>
</div>
