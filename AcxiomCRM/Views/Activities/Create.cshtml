@model AcxiomCRM.ViewModels.ActivityEditViewModel
@{
    ViewData["Title"] = "Log CRM Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-action="Index">Activities</a></li>
                <li class="breadcrumb-item active" aria-current="page">Log Activity</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h4 class="fw-bold mb-0 text-primary"><i class="bi bi-clock-history me-2"></i> Log Customer / Lead Activity</h4>
                <span class="text-muted small">Record notes from completed phone calls, meetings, emails, or tasks</span>
            </div>
            <div class="card-body p-4 pt-2">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label fw-semibold small">Activity Type <span class="text-danger">*</span></label>
                            <select asp-for="ActivityType" class="form-select">
                                @foreach (var t in ActivityTypes.All)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <span asp-validation-for="ActivityType"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label fw-semibold small">Date & Time Conducted <span class="text-danger">*</span></label>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold small">Activity Subject <span class="text-danger">*</span></label>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Introductory discovery call regarding CRM upgrade" autofocus />
                            <span asp-validation-for="Subject"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold small">Customer Link (Optional)</label>
                            <select asp-for="CustomerId" asp-items="Model.AvailableCustomers" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold small">Lead Link (Optional)</label>
                            <select asp-for="LeadId" asp-items="Model.AvailableLeads" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>

                        @if (Model.AvailableUsers.Any())
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold small">Rep</label>
                                <select asp-for="AssignedTo" asp-items="Model.AvailableUsers" class="form-select">
                                    <option value="">-- Assign to Me --</option>
                                </select>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold small">Activity Discussion & Details</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes about discussions, decisions, and customer sentiments..."></textarea>
                            <span asp-validation-for="Description"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Activity Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
